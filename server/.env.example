PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=global shipping company

# Required for authentication
JWT_SECRET=replace-with-strong-random-secret

# Setup routes are disabled by default.
# Enable only for initial bootstrap/maintenance, then disable.
ENABLE_SETUP_ROUTES=false
SETUP_ADMIN_TOKEN=replace-with-strong-random-token

# Optional upload limit for avatar/doc uploads (MB)
MAX_UPLOAD_SIZE_MB=10
